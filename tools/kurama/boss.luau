--!nocheck
-- KuramaBoss (ModuleScript inside the Kurama model). Generated by tools/kurama in 3D-Asset-Agent.
--
-- Poses Kurama's anchored MeshParts about their joints every frame (data in the model's RigData)
-- and plays each move's effects. Clients do the animating and effects, so motion is smooth; the
-- server only says which move to play:
--   server:  local Boss = require(model.KuramaBoss)  Boss.Command(model, "TailSlam")  -- waits for it
--   moves:   TailSlam, Roar, Transform (into the chakra cloak), Bomb (Tailed Beast Bomb), Revert
-- Boss.new(model):start() + :play(name) also work in Studio's Edit mode to preview a move.
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Debris = game:GetService("Debris")

local Boss = {}
Boss.__index = Boss

Boss.Durations = { TailSlam = 4.4, Roar = 3.8, Transform = 4.6, Bomb = 7.4, Revert = 1.6 }

local TEX = {
	fire = "rbxassetid://11534281007", -- 4x4 flipbook flame (Rei's Particle Pack)
	glow = "rbxassetid://4509687978",
	smoke = "rbxassetid://8073306083", -- 8x8 flipbook smoke
	bolt = "rbxassetid://1084955012",
}
local GOLD, CLOAK, INK = Color3.new(1, 0.6, 0.14), Color3.new(1, 0.32, 0.03), Color3.new(0.02, 0.015, 0.015)
local VOID, VIOLET = Color3.new(0.04, 0.0, 0.07), Color3.new(0.55, 0.2, 1)

local function v3(t) return Vector3.new(t[1], t[2], t[3]) end
local function smooth(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end
-- 0 before a, eases to 1 by b, holds until c, eases back to 0 by d
local function env(t, a, b, c, d)
	if t <= a or t >= d then return 0 end
	if t < b then return smooth((t - a) / (b - a)) end
	if t <= c then return 1 end
	return 1 - smooth((t - c) / (d - c))
end
-- turn vector a toward b by ang radians (handedness-proof: built from the vectors themselves)
local function turn(a, b, ang)
	local ax = a:Cross(b)
	if ax.Magnitude < 1e-5 or ang == 0 then return CFrame.identity end
	return CFrame.fromAxisAngle(ax.Unit, ang)
end
local function ns(...) local k = {} local a = { ... } for i = 1, #a, 2 do table.insert(k, NumberSequenceKeypoint.new(a[i], a[i + 1])) end return NumberSequence.new(k) end
local function cs(...) local k = {} local a = { ... } for i = 1, #a, 2 do table.insert(k, ColorSequenceKeypoint.new(a[i], a[i + 1])) end return ColorSequence.new(k) end

------------------------------------------------------------------------------- camera shake (clients)
local shakes = {}
if RunService:IsClient() then
	RunService:BindToRenderStep("KuramaShake", Enum.RenderPriority.Camera.Value + 1, function()
		local cam, now, amt = workspace.CurrentCamera, os.clock(), 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local u = (now - s.t0) / s.dur
			if u >= 1 then table.remove(shakes, i) else
				local fall = s.pos and math.clamp(1 - (cam.CFrame.Position - s.pos).Magnitude / 2500, 0.3, 1) or 1
				amt += s.mag * (1 - u) ^ 1.6 * fall
			end
		end
		if amt > 0 then
			local n = now * 26
			cam.CFrame = cam.CFrame * CFrame.new(math.noise(n, 0.1) * amt * 0.7, math.noise(0.3, n) * amt * 0.7, 0)
				* CFrame.Angles(math.rad(math.noise(n, 5.5) * amt), math.rad(math.noise(7.5, n) * amt), math.rad(math.noise(n, n) * amt * 0.6))
		end
	end)
end
function Boss.Shake(mag, dur, pos) table.insert(shakes, { mag = mag, dur = dur, pos = pos, t0 = os.clock() }) end

------------------------------------------------------------------------------- rig
function Boss.new(model)
	local self = setmetatable({}, Boss)
	self.model = model
	local D = HttpService:JSONDecode(model:WaitForChild("RigData").Value)
	self.D = D
	self.F, self.U, self.L = v3(D.F), v3(D.U), v3(D.L) -- forward, up, his left (model space)
	self.bones, self.order = {}, {}
	for _, b in D.bones do
		local bone = { name = b.name, parent = b.parent, pivot = v3(b.pivot), rest = CFrame.new(v3(b.pivot)) }
		self.bones[b.name] = bone
		table.insert(self.order, bone)
	end
	self.tails = {}
	for i, t in D.tails do
		local dir, aim = v3(t.dir), v3(t.slam)
		self.tails[i] = { dir = dir, slamAxis = dir:Cross(aim).Unit, slamAngle = math.acos(math.clamp(dir:Dot(aim), -1, 1)),
			side = dir:Cross(-self.F).Unit, tip = v3(t.tip), wave = t.wave }
	end
	self.list, self.offsets, self.body, self.marks = {}, {}, {}, {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p:GetAttribute("Rest") then
			self:_add(p, p:GetAttribute("Bone"), p:GetAttribute("Rest"))
			if p.Name:sub(1, 5) == "Mark_" then table.insert(self.marks, p)
			elseif p.Name:sub(1, 5) ~= "glow_" then table.insert(self.body, p) end
		end
	end
	self.mode, self.fxList, self.conns = "base", {}, {}
	self.folder = Instance.new("Folder")
	self.folder.Name = "KuramaFX"
	self.folder.Parent = workspace
	self.t0 = os.clock()
	return self
end

function Boss:_add(p, boneName, rest)
	local bone = self.bones[boneName]
	if not bone then return end
	table.insert(self.list, p)
	table.insert(self.offsets, { bone = bone.name, off = bone.rest:Inverse() * rest })
end

-- model-space point carried by a bone -> world, in the current pose
function Boss:point(boneName, p)
	local b = self.bones[boneName]
	return self.model:GetPivot() * (self.world and self.world[boneName] or b.rest) * (b.rest:Inverse() * p)
end
function Boss:ground() return self.model:GetPivot().Position.Y end

function Boss:apply(pose)
	local base, world = self.model:GetPivot(), {}
	for _, b in self.order do
		local r = pose[b.name] or CFrame.identity
		if b.parent == nil then
			world[b.name] = (pose.root or CFrame.identity) * b.rest * r
		else
			local p = self.bones[b.parent]
			world[b.name] = world[b.parent] * (p.rest:Inverse() * b.rest) * r
		end
	end
	self.world = world
	local cfs = table.create(#self.list)
	for i, o in self.offsets do cfs[i] = base * world[o.bone] * o.off end
	workspace:BulkMoveTo(self.list, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

------------------------------------------------------------------------------- poses
local function mul(pose, name, cf) pose[name] = (pose[name] or CFrame.identity) * cf end

function Boss:idlePose(t, pose)
	local F, U = self.F, self.U
	local cloak = self.mode == "chakra" and 1 or 0
	pose.root = (pose.root or CFrame.identity) * CFrame.new(U * (0.7 * math.sin(t * 2.1)))
	mul(pose, "Skull", turn(F, self.L, 0.07 * math.sin(t * 0.9)) * turn(F, U, 0.04 * math.sin(t * 2.1 + 1)))
	mul(pose, "Jaw", turn(F, -U, 0.06 + 0.04 * math.sin(t * 1.7) + 0.08 * cloak))
	for i, tl in self.tails do
		for k = 1, 3 do
			local a = (0.045 + 0.035 * k) * math.sin(t * (2.3 + 0.4 * cloak) - 0.9 * k + 0.8 * i)
			local b = (0.03 + 0.02 * k) * math.sin(t * 1.6 - 0.7 * k + 1.9 * i)
			mul(pose, "Tail" .. i .. "_" .. k, CFrame.fromAxisAngle(tl.side, a) * CFrame.fromAxisAngle(tl.slamAxis, b))
		end
	end
end

-- tail i bent along its slam arc by k (negative = raised), the tip lagging like a whip
function Boss:tailBend(pose, i, k, k2, k3)
	local tl = self.tails[i]
	mul(pose, "Tail" .. i .. "_1", CFrame.fromAxisAngle(tl.slamAxis, tl.slamAngle * k))
	mul(pose, "Tail" .. i .. "_2", CFrame.fromAxisAngle(tl.slamAxis, 0.35 * tl.slamAngle * (k2 or k)))
	mul(pose, "Tail" .. i .. "_3", CFrame.fromAxisAngle(tl.slamAxis, 0.3 * tl.slamAngle * (k3 or k)))
end

local SLAM_WAVES = { 0.15, 1.45, 2.75 } -- odd tails, even tails, then all nine
local function slamK(t, w)
	if t < w or t > w + 1.4 then return 0 end
	local u = t - w
	if u < 0.45 then return -0.5 * smooth(u / 0.45) end -- wind up: tails rear back and up
	if u < 0.62 then local x = (u - 0.45) / 0.17 return -0.5 + 1.5 * x * x end -- whip down (accelerating)
	if u < 0.8 then return 1 end
	return 1 - smooth((u - 0.8) / 0.6)
end
function Boss:inWave(i, w) return w == 3 or (w == 1) == (i % 2 == 1) end

function Boss:roarPose(e, t, pose)
	local F, U, H = self.F, self.U, self.bones.LegHL.pivot:Lerp(self.bones.LegHR.pivot, 0.5)
	local tremble = 0.015 * e * math.sin(t * 55)
	pose.root = (pose.root or CFrame.identity) * CFrame.new(H) * turn(F, U, 0.2 * e) * CFrame.new(-H)
	for _, leg in { "LegFL", "LegFR" } do mul(pose, leg, turn(F, U, -0.13 * e)) end
	for _, leg in { "LegHL", "LegHR" } do mul(pose, leg, turn(F, U, -0.2 * e)) end
	mul(pose, "Skull", turn(F, U, 0.62 * e + tremble))
	mul(pose, "Jaw", turn(F, -U, 0.62 * e))
	for i in self.tails do self:tailBend(pose, i, -0.32 * e + tremble * 3) end
end

local POSES = {}
function POSES.TailSlam(self, t, pose)
	local F, U = self.F, self.U
	local snarl = env(t, 0, 0.3, 4.0, 4.4)
	mul(pose, "Jaw", turn(F, -U, 0.35 * snarl))
	local dip = 0
	for w, t0 in SLAM_WAVES do
		dip += env(t, t0 + 0.55, t0 + 0.62, t0 + 0.68, t0 + 1.0)
		for i in self.tails do
			if self:inWave(i, w) then self:tailBend(pose, i, slamK(t, t0), slamK(t - 0.05, t0), slamK(t - 0.1, t0)) end
		end
	end
	pose.root = (pose.root or CFrame.identity) * CFrame.new(-U * 2.5 * dip) * turn(F, U, -0.04 * dip)
	mul(pose, "Skull", turn(F, U, -0.12 * snarl + 0.1 * dip) * turn(F, self.L, 0.12 * math.sin(t * 9) * snarl))
end
function POSES.Roar(self, t, pose)
	local crouch = env(t, 0, 0.4, 0.5, 0.95)
	pose.root = (pose.root or CFrame.identity) * CFrame.new(-self.U * 3 * crouch - self.F * 3 * crouch)
	mul(pose, "Skull", turn(self.F, self.U, -0.18 * crouch))
	self:roarPose(env(t, 0.5, 1.0, 2.9, 3.7), t, pose)
end
function POSES.Transform(self, t, pose)
	local crouch = env(t, 0, 0.7, 1.4, 1.7)
	local tremble = 0.03 * crouch * math.sin(t * 60)
	pose.root = (pose.root or CFrame.identity) * CFrame.new(-self.U * 5 * crouch + self.L * tremble * 20)
	mul(pose, "Skull", turn(self.F, self.U, -0.25 * crouch + tremble))
	for i in self.tails do self:tailBend(pose, i, 0.25 * crouch + tremble) end
	self:roarPose(env(t, 1.55, 1.9, 3.6, 4.5), t, pose)
end
function POSES.Bomb(self, t, pose)
	local F, U = self.F, self.U
	local aim = env(t, 0.2, 0.9, 6.5, 7.3)
	local recoil = env(t, 4.05, 4.12, 4.25, 4.9)
	local H = self.bones.LegHL.pivot:Lerp(self.bones.LegHR.pivot, 0.5)
	pose.root = (pose.root or CFrame.identity) * CFrame.new(-F * 7 * recoil) * CFrame.new(H) * turn(F, -U, 0.06 * aim) * CFrame.new(-H)
	mul(pose, "Skull", turn(F, U, -0.05 * aim + 0.22 * recoil))
	mul(pose, "Jaw", turn(F, -U, 0.62 * aim))
	for i in self.tails do self:tailBend(pose, i, -0.42 * aim + 0.02 * math.sin(t * 13 + i)) end
end
function POSES.Revert(self, t, pose)
	self:roarPose(env(t, 0, 0.3, 0.6, 1.4) * 0.5, t, pose)
end

------------------------------------------------------------------------------- effects
function Boss:part(props)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do p[k] = v end
	p.Parent = self.folder
	return p
end
local function tween(i, time, goal, style, dir)
	local tw = TweenService:Create(i, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
function Boss:emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.LightInfluence = 0
	for k, v in props do e[k] = v end
	e.Parent = parent
	return e
end
-- a burst of particles at pos, then the host cleans itself up
function Boss:burst(pos, life, emitters)
	local host = self:part({ Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(pos) })
	for _, props in emitters do
		local n = props.Emit props.Emit = nil
		props.Enabled = false
		self:emitter(host, props):Emit(n)
	end
	Debris:AddItem(host, life)
	return host
end
-- an expanding ForceField dome (shockwave) or a flattened one (ground ring)
function Boss:wave(pos, r0, r1, time, color, flat, mat)
	local p = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * r0 * 2, CFrame = CFrame.new(pos), Color = color,
		Material = mat or Enum.Material.ForceField, Transparency = 0 })
	if flat then
		p.Shape = Enum.PartType.Block
		local m = Instance.new("SpecialMesh") m.MeshType = Enum.MeshType.Sphere m.Scale = Vector3.new(1, 0.06, 1) m.Parent = p
	end
	tween(p, time, { Size = Vector3.one * r1 * 2, Transparency = 1 })
	Debris:AddItem(p, time + 0.1)
	return p
end
function Boss:dust(pos, scale)
	self:burst(pos, 4, {
		{ Texture = TEX.smoke, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8, FlipbookMode = Enum.ParticleFlipbookMode.Loop,
			FlipbookFramerate = NumberRange.new(20, 25), FlipbookStartRandom = true, Color = cs(0, Color3.new(0.55, 0.47, 0.38), 1, Color3.new(0.35, 0.3, 0.26)),
			Size = ns(0, 9 * scale, 1, 26 * scale), Transparency = ns(0, 0.35, 0.6, 0.6, 1, 1), Lifetime = NumberRange.new(1.4, 2.4),
			Speed = NumberRange.new(25 * scale, 55 * scale), Drag = 3.5, SpreadAngle = Vector2.new(80, 80), EmissionDirection = Enum.NormalId.Top,
			Acceleration = Vector3.new(0, 6, 0), Rotation = NumberRange.new(-180, 180), RotSpeed = NumberRange.new(-30, 30), LightInfluence = 1, Emit = 18 },
		{ Texture = TEX.smoke, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8, Color = cs(0, Color3.new(0.3, 0.25, 0.2), 1, Color3.new(0.3, 0.25, 0.2)),
			Size = ns(0, 3 * scale, 1, 1), Lifetime = NumberRange.new(0.8, 1.3), Speed = NumberRange.new(60 * scale, 110 * scale), SpreadAngle = Vector2.new(60, 60),
			EmissionDirection = Enum.NormalId.Top, Acceleration = Vector3.new(0, -120, 0), LightInfluence = 1, Emit = 26 },
	})
	self:wave(pos, 4 * scale, 38 * scale, 0.7, Color3.new(1, 0.85, 0.6), true)
	-- chunks of ground flung up
	for _ = 1, 5 do
		local r = self:part({ Size = Vector3.new(1, 1, 1) * math.random(2, 5) * scale * 0.6, CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			Color = Color3.new(0.33, 0.27, 0.2), Material = Enum.Material.Slate, Anchored = false })
		r.AssemblyLinearVelocity = Vector3.new(math.random(-40, 40), math.random(60, 110), math.random(-40, 40)) * scale * 0.7
		Debris:AddItem(r, 3)
	end
end

function Boss:setMode(mode)
	if mode == self.mode then return end
	self.mode = mode
	for _, x in self.fxList do x:Destroy() end
	self.fxList = {}
	if self.shells then
		for _, s in self.shells do
			local i = table.find(self.list, s)
			table.remove(self.list, i) table.remove(self.offsets, i)
			s:Destroy()
		end
		self.shells = nil
	end
	local chakra = mode == "chakra"
	self.saved = self.saved or {}
	for _, p in self.body do
		local s = self.saved[p] or { Color = p.Color, Material = p.Material, TextureID = p.TextureID, Transparency = p.Transparency }
		self.saved[p] = s
		if chakra then p.TextureID, p.Color, p.Material, p.Transparency = "", GOLD, Enum.Material.Neon, 0.08
		else for k, v in s do p[k] = v end end
	end
	for _, p in self.marks do p.Transparency = chakra and 0 or 1 p.Color = INK end
	local eyes = self.model:FindFirstChild("glow_Eyes", true)
	if eyes then eyes.Color = chakra and Color3.new(1, 0.92, 0.55) or Color3.new(1, 0.08, 0.03) end
	if not chakra then return end
	-- the cloak: a translucent neon shell over every body part, fire licking off it and an orange haze
	self.shells = {}
	for _, p in self.body do
		local s = p:Clone()
		s:ClearAllChildren()
		s.Name = p.Name .. "_Cloak"
		s.Size = p.Size * 1.07
		s.Color, s.Material, s.Transparency, s.CastShadow, s.CanQuery = CLOAK, Enum.Material.Neon, 0.72, false, false
		s:SetAttribute("Rest", nil)
		s.Parent = self.folder
		local i = table.find(self.list, p)
		table.insert(self.list, s)
		table.insert(self.offsets, { bone = self.offsets[i].bone, off = self.offsets[i].off })
		table.insert(self.shells, s)
		local vol = p.Size.X * p.Size.Y * p.Size.Z
		local k = math.clamp((vol / 4000) ^ 0.33, 0.6, 2.2)
		table.insert(self.fxList, self:emitter(s, { Texture = TEX.fire, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
			FlipbookMode = Enum.ParticleFlipbookMode.OneShot, Color = cs(0, Color3.new(1, 0.62, 0.18), 0.5, Color3.new(1, 0.3, 0.03), 1, Color3.new(0.45, 0.06, 0.02)),
			Size = ns(0, 7 * k, 1, 2 * k), Transparency = ns(0, 0.35, 0.7, 0.6, 1, 1), Lifetime = NumberRange.new(0.5, 1.0),
			Speed = NumberRange.new(2, 7), Acceleration = Vector3.new(0, 30, 0), Rate = math.clamp(vol / 900, 4, 22),
			Rotation = NumberRange.new(-180, 180), RotSpeed = NumberRange.new(-40, 40), LightEmission = 0.75 }))
		table.insert(self.fxList, self:emitter(s, { Texture = TEX.smoke, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8,
			FlipbookMode = Enum.ParticleFlipbookMode.Loop, FlipbookFramerate = NumberRange.new(15, 20), FlipbookStartRandom = true,
			Color = cs(0, Color3.new(0.75, 0.25, 0.04), 1, Color3.new(0.35, 0.08, 0.02)), Size = ns(0, 10 * k, 1, 24 * k),
			Transparency = ns(0, 1, 0.3, 0.72, 1, 1), Lifetime = NumberRange.new(1.4, 2.4), Speed = NumberRange.new(1, 4),
			Acceleration = Vector3.new(0, 8, 0), Rate = math.clamp(vol / 2500, 1, 8), Rotation = NumberRange.new(-180, 180),
			RotSpeed = NumberRange.new(-15, 15), LightEmission = 0.35 }))
	end
	local torso = self.model:FindFirstChild("Torso", true)
	local light = Instance.new("PointLight") light.Color, light.Range, light.Brightness = Color3.new(1, 0.45, 0.1), 60, 3
	light.Parent = torso
	table.insert(self.fxList, light)
end

-- the Tailed Beast Bomb: dark orbs converge in front of the open jaws into a dense core, then it flies
function Boss:bomb()
	local M = v3(self.D.mouth)
	local at = function() return self:point("Skull", M) end
	local core = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2, Color = VOID, Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(at()) })
	local rim = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, Color = VIOLET, Material = Enum.Material.ForceField, CFrame = core.CFrame })
	local haze = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 3, Color = Color3.new(0.35, 0.1, 0.7), Material = Enum.Material.Neon, Transparency = 0.82, CFrame = core.CFrame })
	local pull = self:part({ Size = Vector3.one * 140, Transparency = 1, CFrame = core.CFrame })
	local light = Instance.new("PointLight") light.Color, light.Range, light.Brightness = VIOLET, 60, 6 light.Parent = haze
	local inward = self:emitter(pull, { Texture = TEX.glow, Shape = Enum.ParticleEmitterShape.Sphere, ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface, Speed = NumberRange.new(110, 140), Lifetime = NumberRange.new(0.5, 0.6),
		Color = cs(0, Color3.new(0.2, 0.05, 0.35), 1, VIOLET), Size = ns(0, 5, 1, 1), Transparency = ns(0, 1, 0.3, 0.2, 1, 0.6), Rate = 160, LightEmission = 0.6 })
	local bolts = self:emitter(core, { Texture = TEX.bolt, LockedToPart = true, Rate = 14, Lifetime = NumberRange.new(0.15, 0.25), Speed = NumberRange.new(0, 0),
		Rotation = NumberRange.new(-180, 180), Color = cs(0, Color3.new(0.8, 0.55, 1), 1, VIOLET), Size = ns(0, 6, 1, 6), LightEmission = 1 })
	local parts = { core, rim, haze, pull }
	local charge, t0 = 3.2, os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local c = math.clamp((os.clock() - t0) / charge, 0, 1)
		local r = 2 + 20 * c ^ 0.7 * (1 + 0.06 * math.sin(os.clock() * 30))
		local cf = CFrame.new(at()) * CFrame.Angles(0, os.clock() * 3, 0)
		core.Size, rim.Size, haze.Size = Vector3.one * r * 2, Vector3.one * r * 2.25, Vector3.one * r * 3.2
		core.CFrame, rim.CFrame, haze.CFrame, pull.CFrame = cf, cf, cf, cf
		bolts.Size = ns(0, r * 1.6, 1, r * 1.6)
	end)
	-- orbs of black and violet chakra streaming in from all around
	task.spawn(function()
		while os.clock() - t0 < charge - 0.2 do
			local from = at() + Random.new():NextUnitVector() * math.random(50, 120)
			local o = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * math.random(3, 8), CFrame = CFrame.new(from),
				Color = math.random() < 0.5 and VOID or Color3.new(0.45, 0.15, 0.85), Material = Enum.Material.Neon })
			tween(o, 0.55, { Position = at(), Size = Vector3.one * 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Debris:AddItem(o, 0.6)
			task.wait(0.025)
		end
	end)
	Boss.Shake(0.35, charge, at())
	task.wait(charge + 0.05)
	-- fire: the bomb leaves the jaws and hits the ground far ahead
	conn:Disconnect()
	inward.Enabled = false
	pull:Destroy()
	local base = self.model:GetPivot()
	local start = core.Position
	local target = base:PointToWorldSpace(self.F * 430)
	target = Vector3.new(target.X, self:ground() + 4, target.Z)
	self:emitter(haze, { Texture = TEX.glow, Color = cs(0, VIOLET, 1, Color3.new(0.2, 0.05, 0.4)), Size = ns(0, 40, 1, 10),
		Transparency = ns(0, 0.3, 1, 1), Lifetime = NumberRange.new(0.25, 0.4), Speed = NumberRange.new(0, 2), Rate = 90, LightEmission = 1 })
	self:wave(start, 6, 40, 0.4, VIOLET)
	Boss.Shake(1.4, 0.5, start)
	local fly, t1 = 0.5, os.clock()
	while os.clock() - t1 < fly do
		local u = (os.clock() - t1) / fly
		local cf = CFrame.new(start:Lerp(target, u))
		core.CFrame, rim.CFrame, haze.CFrame = cf, cf, cf
		RunService.Heartbeat:Wait()
	end
	for _, p in parts do if p.Parent then p:Destroy() end end
	self:explode(target)
end

function Boss:explode(pos)
	Boss.Shake(4.5, 2.2, pos)
	local flash = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 30, CFrame = CFrame.new(pos), Color = Color3.new(0.8, 0.62, 1), Material = Enum.Material.Neon })
	tween(flash, 0.22, { Size = Vector3.one * 300 })
	task.delay(0.22, function() tween(flash, 0.7, { Transparency = 1 }) end)
	Debris:AddItem(flash, 1)
	local dark = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 20, CFrame = CFrame.new(pos), Color = VOID, Material = Enum.Material.SmoothPlastic, Transparency = 0.15 })
	tween(dark, 0.4, { Size = Vector3.one * 200 })
	task.delay(0.35, function() tween(dark, 0.6, { Transparency = 1 }) end)
	Debris:AddItem(dark, 1.1)
	self:wave(pos, 20, 300, 1.4, Color3.new(0.75, 0.55, 1))
	self:wave(pos, 30, 450, 1.8, Color3.new(1, 0.8, 0.6), true)
	task.delay(0.15, function() self:wave(pos, 15, 220, 1.1, VIOLET) end)
	self:burst(pos, 6, {
		{ Texture = TEX.fire, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4, FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
			Color = cs(0, Color3.new(1, 0.85, 1), 0.3, Color3.new(0.7, 0.35, 1), 1, Color3.new(1, 0.4, 0.1)), Size = ns(0, 55, 1, 70),
			Transparency = ns(0, 0, 0.6, 0.4, 1, 1), Lifetime = NumberRange.new(0.7, 1.3), Speed = NumberRange.new(120, 320), Drag = 5,
			SpreadAngle = Vector2.new(180, 180), Rotation = NumberRange.new(-180, 180), LightEmission = 1, Emit = 70 },
		{ Texture = TEX.glow, Color = cs(0, Color3.new(0.85, 0.7, 1), 1, VIOLET), Size = ns(0, 160, 1, 260), Transparency = ns(0, 0.2, 1, 1),
			Lifetime = NumberRange.new(0.6, 0.9), Speed = NumberRange.new(0, 0), LightEmission = 1, Emit = 6 },
		{ Texture = TEX.smoke, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8, FlipbookMode = Enum.ParticleFlipbookMode.Loop,
			FlipbookFramerate = NumberRange.new(12, 18), FlipbookStartRandom = true, Color = cs(0, Color3.new(0.78, 0.68, 0.8), 1, Color3.new(0.55, 0.5, 0.5)),
			Size = ns(0, 50, 1, 140), Transparency = ns(0, 0.4, 0.7, 0.7, 1, 1), Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(40, 140),
			Drag = 1.6, SpreadAngle = Vector2.new(90, 90), EmissionDirection = Enum.NormalId.Top, Acceleration = Vector3.new(0, 14, 0),
			Rotation = NumberRange.new(-180, 180), RotSpeed = NumberRange.new(-20, 20), LightInfluence = 0.3, Brightness = 1.4, Emit = 45 },
	})
	local lightHost = self:part({ Size = Vector3.one, Transparency = 1, CFrame = CFrame.new(pos + Vector3.new(0, 30, 0)) })
	local light = Instance.new("PointLight") light.Color, light.Range, light.Brightness = Color3.new(0.8, 0.6, 1), 60, 12 light.Parent = lightHost
	tween(light, 2, { Brightness = 0 })
	Debris:AddItem(lightHost, 2.1)
	for _ = 1, 16 do
		local r = self:part({ Size = Vector3.one * math.random(4, 10), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			Color = Color3.new(0.3, 0.25, 0.2), Material = Enum.Material.Slate, Anchored = false })
		r.AssemblyLinearVelocity = Vector3.new(math.random(-140, 140), math.random(90, 200), math.random(-140, 140))
		Debris:AddItem(r, 5)
	end
end

-- what each move does when (seconds from its start)
local EVENTS = {}
function EVENTS.TailSlam(self)
	for w, t0 in SLAM_WAVES do
		task.delay(t0 + 0.6, function()
			local any
			for i, tl in self.tails do
				if self:inWave(i, w) then
					local tip = self:point("Tail" .. i .. "_3", tl.tip)
					local g = Vector3.new(tip.X, self:ground() + 1, tip.Z)
					self:dust(g, w == 3 and 1.6 or 1.2)
					any = g
				end
			end
			Boss.Shake(w == 3 and 2.6 or 1.5, w == 3 and 0.9 or 0.55, any)
		end)
	end
end
function EVENTS.Roar(self)
	task.delay(1.0, function()
		local mouth = self:point("Skull", v3(self.D.mouth))
		Boss.Shake(2.4, 2.1, mouth)
		self:wave(self.model:GetPivot().Position, 10, 160, 1.2, Color3.new(1, 0.8, 0.55), true)
		for k = 0, 4 do task.delay(k * 0.38, function() self:wave(self:point("Skull", v3(self.D.mouth)), 6, 70 + k * 10, 0.8, Color3.new(1, 0.9, 0.8)) end) end
		self:dust(self.model:GetPivot().Position, 2.2)
	end)
end
function EVENTS.Transform(self)
	local torso = self:point("Torso", self.bones.Torso.pivot)
	local host = self:part({ Size = Vector3.new(60, 40, 90), Transparency = 1, CFrame = CFrame.new(torso) })
	self:emitter(host, { Texture = TEX.smoke, FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8, FlipbookMode = Enum.ParticleFlipbookMode.Loop,
		FlipbookFramerate = NumberRange.new(15, 20), Color = cs(0, Color3.new(0.6, 0.06, 0.02), 1, Color3.new(0.15, 0.02, 0.02)),
		Size = ns(0, 12, 1, 30), Transparency = ns(0, 1, 0.3, 0.5, 1, 1), Lifetime = NumberRange.new(1, 1.6), Speed = NumberRange.new(4, 10),
		Acceleration = Vector3.new(0, 25, 0), Rate = 45, Rotation = NumberRange.new(-180, 180), LightEmission = 0.4 })
	Boss.Shake(0.6, 1.5, torso)
	Debris:AddItem(host, 2.5)
	task.delay(1.45, function()
		host:FindFirstChildOfClass("ParticleEmitter").Enabled = false
		local c = self:point("Torso", self.bones.Torso.pivot)
		local flash = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 20, CFrame = CFrame.new(c), Color = Color3.new(1, 0.85, 0.5), Material = Enum.Material.Neon })
		tween(flash, 0.25, { Size = Vector3.one * 230 })
		task.delay(0.25, function() tween(flash, 0.6, { Transparency = 1 }) end)
		Debris:AddItem(flash, 0.9)
		self:wave(self.model:GetPivot().Position, 20, 380, 1.5, Color3.new(1, 0.6, 0.2), true)
		self:wave(c, 20, 200, 1.0, Color3.new(1, 0.65, 0.25))
		Boss.Shake(3.2, 1.4, c)
		task.delay(0.12, function() self:setMode("chakra") end)
	end)
	task.delay(2.0, function()
		for k = 0, 3 do task.delay(k * 0.4, function() self:wave(self:point("Skull", v3(self.D.mouth)), 6, 80, 0.8, Color3.new(1, 0.7, 0.3)) end) end
	end)
end
function EVENTS.Bomb(self)
	task.delay(0.85, function() self:bomb() end)
end
function EVENTS.Revert(self)
	task.delay(0.5, function()
		local c = self:point("Torso", self.bones.Torso.pivot)
		local flash = self:part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 150, CFrame = CFrame.new(c), Color = Color3.new(1, 0.6, 0.2), Material = Enum.Material.Neon, Transparency = 0.3 })
		tween(flash, 0.6, { Size = Vector3.one * 20, Transparency = 1 })
		Debris:AddItem(flash, 0.7)
		self:setMode("base")
	end)
end

------------------------------------------------------------------------------- driving
function Boss:start()
	if self.conn then return self end
	self.conn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local pose = {}
		local m = self.move
		if m then
			local t = now - m.t0
			if t > Boss.Durations[m.name] then self.move = nil else POSES[m.name](self, t, pose) end
		end
		self:idlePose(now - self.t0, pose)
		self:apply(pose)
	end)
	return self
end

-- play a move (returns at once; Boss.Durations[name] says how long it runs)
function Boss:play(name)
	assert(POSES[name], "no move " .. tostring(name))
	self.move = { name = name, t0 = os.clock() }
	EVENTS[name](self)
end

-- freeze in a move's pose at time t, no effects (screenshots)
function Boss:pose(name, t)
	local pose = {}
	if name ~= "Idle" then POSES[name](self, t, pose) end
	self:idlePose(0, pose)
	self:apply(pose)
end

function Boss:stop()
	if self.conn then self.conn:Disconnect() self.conn = nil end
	self:setMode("base")
	self:apply({})
	self.folder:Destroy()
end

------------------------------------------------------------------------------- server side
-- Boss.Command(model, move): every client plays it; returns when it has finished.
function Boss.Command(model, name)
	local ev = game:GetService("ReplicatedStorage"):WaitForChild("KuramaMove")
	if name == "Transform" then model:SetAttribute("Mode", "chakra") elseif name == "Revert" then model:SetAttribute("Mode", "base") end
	ev:FireAllClients(model, name)
	task.wait(Boss.Durations[name])
end

return Boss
