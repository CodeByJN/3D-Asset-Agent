-- KuramaBrain (Script inside the Kurama model). Generated by tools/kurama in 3D-Asset-Agent.
-- Demo: loops tail slams -> roar -> transform -> Tailed Beast Bomb -> revert while the model's Demo
-- attribute is true. A boss AI can instead call Boss.Command(model, move) itself (set Demo false).
local Players = game:GetService("Players")
local model = script.Parent
local Boss = require(model:WaitForChild("KuramaBoss"))
model:SetAttribute("Mode", "base")

repeat task.wait(0.5) until #Players:GetPlayers() > 0
task.wait(3) -- let the first client load the model
local SEQUENCE = { { "TailSlam", 1.5 }, { "Roar", 1.5 }, { "Transform", 2.5 }, { "Bomb", 2.5 }, { "Revert", 2.5 } }
while model.Parent do
	if model:GetAttribute("Demo") ~= false then
		for _, step in SEQUENCE do
			Boss.Command(model, step[1])
			task.wait(step[2])
		end
	else
		task.wait(1)
	end
end
